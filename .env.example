# Configuration locale : copier ce fichier en .env (ignoré par git), puis lancer
# uv run --env-file .env news-feed serve

# Microsoft Foundry : portail Foundry → ta ressource → Vue d'ensemble → « Point de terminaison » et « Clé ».
# L'endpoint se termine par /openai/v1/. La ressource doit avoir les déploiements embed, fast et main.
OPENAI_BASE_URL=https://<ressource>.openai.azure.com/openai/v1/
OPENAI_API_KEY=

# Facultatif (valeurs par défaut) :
# NEWS_FEED_DATA_DIR=data
# NEWS_FEED_REFRESH_MINUTES=20
# NEWS_FEED_ALLOWED_USER : seulement sur Azure (Easy Auth), ne pas le définir en local.
